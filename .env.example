# Name that shows up as the Spotify Connect device
DEVICE_NAME=Stream Output

# Device type shown in Spotify (computer, tablet, smartphone, speaker,
# tv, stb, avr, automobile, cast_video, cast_audio, accessory, observer)
DEVICE_TYPE=speaker

# Icecast source password (used by the streamer to push audio in)
ICECAST_SOURCE_PASSWORD=hackme

# Icecast admin password (used for the /admin web UI)
ICECAST_ADMIN_PASSWORD=hackme

# Icecast relay password (not really used in this POC, but icecast.xml wants one)
ICECAST_RELAY_PASSWORD=hackme

# Mount point the MP3 stream will be published under, e.g. http://host:8000/stream.mp3
MOUNT_POINT=stream.mp3

# MP3 encoding bitrate for the Icecast stream: 96k, 160k, or 320k
MP3_BITRATE=320k

# --- Auth mode ---
# zeroconf (default): LAN-only, device discovered via mDNS.
# device-auth: pair at spotify.com/pair. Works remotely, no stored password.
# oauth: browser-based OAuth callback on OAUTH_PORT.
AUTH_MODE=zeroconf

# Keep Spotify Connect mDNS discovery disabled after account auth.
DISABLE_DISCOVERY=false

# go-librespot REST API used by the metadata poller.
GO_LIBRESPOT_API_HOST=127.0.0.1
GO_LIBRESPOT_API_BIND_ADDRESS=0.0.0.0
GO_LIBRESPOT_API_PORT=3678

# mDNS backend: builtin or avahi
GO_LIBRESPOT_ZEROCONF_BACKEND=builtin

# Only used for AUTH_MODE=oauth
OAUTH_PORT=8888
