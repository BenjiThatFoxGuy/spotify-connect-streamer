# Name that shows up as the Spotify Connect device
DEVICE_NAME=Stream Output

# Icecast source password (used by the streamer to push audio in)
ICECAST_SOURCE_PASSWORD=hackme

# Icecast admin password (used for the /admin web UI)
ICECAST_ADMIN_PASSWORD=hackme

# Icecast relay password (not really used in this POC, but icecast.xml wants one)
ICECAST_RELAY_PASSWORD=hackme

# Mount point the MP3 stream will be published under, e.g. http://host:8000/stream.mp3
MOUNT_POINT=stream.mp3

# Audio backend: subprocess (default, cleaner track transitions) or pipe (fallback)
BACKEND=subprocess

# MP3 encoding bitrate
MP3_BITRATE=192k

# Any extra flags to pass straight through to librespot (advanced use)
LIBRESPOT_EXTRA_ARGS=

# --- Remote mode (optional) ---
# Leave both of these unset for LAN-only zeroconf discovery (the safer default:
# only devices on your local network can see and control this Connect device).
# Set both to log in with a real Spotify account instead, which lets the device
# be selected from anywhere the account is signed in.
# SPOTIFY_USERNAME=
# SPOTIFY_PASSWORD=
