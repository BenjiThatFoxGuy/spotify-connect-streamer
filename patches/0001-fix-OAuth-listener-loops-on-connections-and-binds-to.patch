From 4a0376923b845ed4765cd53785c77262cf346f3a Mon Sep 17 00:00:00 2001
From: Dockerfile <build@dockerfile>
Date: Tue, 22 Sep 2026 22:26:44 +0000
Subject: [PATCH] fix: OAuth listener loops on connections and binds to 0.0.0.0

The original listener consumed the first TCP connection regardless of
whether it carried the OAuth callback code. Non-callback requests
(favicon, health checks, direct visits) would eat the connection and
fail the auth flow.

Now the listener loops, answering non-callback requests with a waiting
message and only completing when a request with ?code= arrives.

Also binds to 0.0.0.0 instead of the redirect URI's IP so the OAuth
server is reachable through reverse proxies and SSH tunnels.
---
 oauth/src/lib.rs | 83 +++++++++++++++++++++++++++++-------------------
 1 file changed, 51 insertions(+), 32 deletions(-)

diff --git a/oauth/src/lib.rs b/oauth/src/lib.rs
index 406052a..05330ba 100644
--- a/oauth/src/lib.rs
+++ b/oauth/src/lib.rs
@@ -204,6 +204,11 @@ fn get_authcode_stdin() -> Result<AuthorizationCode, OAuthError> {
 }
 
 /// Spawn HTTP server at provided socket address to accept OAuth callback and return auth code.
+///
+/// Accepts connections in a loop so that non-callback requests (favicon probes,
+/// direct browser visits, health checks) are answered without consuming the
+/// listener.  Only the first request carrying a `?code=` parameter completes
+/// the flow.
 fn get_authcode_listener(
     socket_address: SocketAddr,
     message: String,
@@ -215,47 +220,61 @@ fn get_authcode_listener(
         })?;
     info!("OAuth server listening on {socket_address:?}");
 
-    // The server will terminate itself after collecting the first code.
-    let mut stream = listener
-        .incoming()
-        .flatten()
-        .next()
-        .ok_or(OAuthError::AuthCodeListenerTerminated)?;
-    let mut reader = BufReader::new(&stream);
-    let mut request_line = String::new();
-    reader
-        .read_line(&mut request_line)
-        .map_err(|_| OAuthError::AuthCodeListenerRead)?;
-
-    let redirect_url = request_line
-        .split_whitespace()
-        .nth(1)
-        .ok_or(OAuthError::AuthCodeListenerParse)?;
-    let code = get_code(&("http://localhost".to_string() + redirect_url));
-
-    let response = format!(
-        "HTTP/1.1 200 OK\r\ncontent-length: {}\r\n\r\n{}",
-        message.len(),
-        message
-    );
-    stream
-        .write_all(response.as_bytes())
-        .map_err(|_| OAuthError::AuthCodeListenerWrite)?;
-
-    code
+    for stream in listener.incoming().flatten() {
+        let mut stream = stream;
+        let mut reader = BufReader::new(&stream);
+        let mut request_line = String::new();
+        if reader.read_line(&mut request_line).is_err() {
+            continue;
+        }
+
+        let path = match request_line.split_whitespace().nth(1) {
+            Some(p) => p.to_string(),
+            None => continue,
+        };
+
+        let url = "http://localhost".to_string() + &path;
+        match get_code(&url) {
+            Ok(code) => {
+                let response = format!(
+                    "HTTP/1.1 200 OK\r\ncontent-length: {}\r\n\r\n{}",
+                    message.len(),
+                    message
+                );
+                let _ = stream.write_all(response.as_bytes());
+                return Ok(code);
+            }
+            Err(_) => {
+                let wait_msg = "Waiting for Spotify login callback...";
+                let response = format!(
+                    "HTTP/1.1 200 OK\r\ncontent-length: {}\r\n\r\n{}",
+                    wait_msg.len(),
+                    wait_msg
+                );
+                let _ = stream.write_all(response.as_bytes());
+                info!("OAuth server: ignored non-callback request to {path}");
+            }
+        }
+    }
+
+    Err(OAuthError::AuthCodeListenerTerminated)
 }
 
 // If the specified `redirect_uri` is HTTP and contains a port,
 // then the corresponding socket address is returned.
+// Binds to 0.0.0.0 (all interfaces) so the OAuth callback server is
+// reachable through reverse proxies and SSH tunnels, not just loopback.
 fn get_socket_address(redirect_uri: &str) -> Option<SocketAddr> {
     let url = match Url::parse(redirect_uri) {
         Ok(u) if u.scheme() == "http" && u.port().is_some() => u,
         _ => return None,
     };
-    match url.socket_addrs(|| None) {
-        Ok(mut addrs) => addrs.pop(),
-        _ => None,
-    }
+    url.port().map(|p| {
+        SocketAddr::new(
+            std::net::IpAddr::V4(std::net::Ipv4Addr::UNSPECIFIED),
+            p,
+        )
+    })
 }
 
 /// Struct that handle obtaining and refreshing access tokens.
